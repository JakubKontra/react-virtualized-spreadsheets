{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@sheet/core": ["packages/core/src/index.ts"],
      "@sheet/react": ["packages/react/src/index.ts"],
      "@sheet/transport": ["packages/transport/src/index.ts"],
      "@sheet/ui": ["packages/ui/src/index.ts"],
      "@sheet/ui/*": ["packages/ui/src/*"]
    }
  },
  "include": ["packages", "apps", "tests", "benchmarks", "*.config.ts"],
  "exclude": ["apps/docs"]
}
