{
  "name": "react-spreadsheets-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:web": "vite --config apps/demo/vite.config.ts",
    "dev:server": "tsx apps/server/src/index.ts",
    "build": "pnpm -r --filter './packages/**' build && vite build --config apps/demo/vite.config.ts && vite build --config apps/ui-example/vite.config.ts",
    "typecheck": "tsc --noEmit && node scripts/check-type-safety.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "pnpm -r --filter \"./packages/**\" build && playwright test",
    "benchmark": "tsx benchmarks/engine.ts",
    "benchmark:browser": "playwright test --config playwright.benchmark.config.ts",
    "dev:ui-example": "vite --config apps/ui-example/vite.config.ts",
    "test:ui-package": "pnpm -r --filter \"./packages/**\" build && node scripts/check-ui-package.mjs",
    "prepare:docs": "pnpm -r --filter \"./packages/**\" build && vite build --config apps/docs-examples/vite.config.ts",
    "dev:docs": "pnpm prepare:docs && pnpm --filter @sheet/docs start --no-open",
    "build:docs": "pnpm prepare:docs && pnpm --filter @sheet/docs typecheck && pnpm --filter @sheet/docs build",
    "serve:docs": "pnpm --filter @sheet/docs serve",
    "test:docs": "pnpm build:docs && playwright test --config playwright.docs.config.ts",
    "pack:release": "pnpm -r --filter \"./packages/**\" build && node scripts/pack-release.mjs",
    "check:types": "node scripts/check-type-safety.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  },
  "license": "MIT"
}
